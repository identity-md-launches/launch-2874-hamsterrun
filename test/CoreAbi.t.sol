pragma solidity 0.8.26;

import { GameTest } from "./helpers/GameTest.sol";
import { ISqueekCore } from "../src/interfaces/ISqueekCore.sol";

/// @notice ABI regression using raw eth_call bytes, not locally ABI-encoded tuples.
/// @dev Sepolia finalized block 12047523, 0x0741435d7dfa7dbf53076fe8c2dcac3d74346fdf15feb0c817acf492de7026f0.
///      Reproduced in docs/core-sepolia-snapshot.json. No RPC or filesystem dependency at test time.
contract CoreAbiTest is GameTest {
    function _configuration() private {
        vm.mockCall(
            address(core),
            abi.encodeCall(ISqueekCore.configuration, ()),
            hex""
        );
    }

    function _ledger() private {
        vm.mockCall(
            address(core),
            abi.encodeCall(ISqueekCore.state, ()),
            hex""
        );
        vm.mockCall(
            address(core),
            abi.encodeCall(ISqueekCore.roundPage, (1867, 1873, 6)),
            hex""
        );
    }

    function test_publishedCoreV3AbiMatchesFinalizedSepoliaReadBytes() public {
        _configuration();
        _ledger();
        vm.warp(1793614932);
        ISqueekCore.CoreConfiguration memory config = nft.core().configuration();
        assertEq(config.genesisTimestamp, 1791847800);
        assertEq(config.roundDuration, 600);
        assertEq(config.maxWorkPerRound, 10000);
        assertEq(config.maxRoundsPerBatch, 16);
        assertEq(nft.currentRound(), 2946);
        assertEq(nft.settledThroughRound(), 1973);
        ISqueekCore.RoundPage memory page = nft.core().roundPage(1867, 1873, 6);
        assertEq(page.certifiedThroughRound, 1873);
        assertEq(page.rounds.length, 3);
        assertEq(page.start.cumulativeWork, 143148);
        assertEq(page.end.cumulativeWork, 144160);
        assertEq(nft.certifiedWork(1868, 1873), 1012);
    }

    function test_historicalWindowSettlesAgainstRawCertifiedCorePage() public {
        _configuration();
        vm.warp(1791847800 + (1868 - 1) * 600);
        uint256 id = _mintFed(alice, 2);
        vm.prank(alice);
        nft.startTraining(id);
        (uint64 start, uint64 end,,) = nft.training(id);
        assertEq(start, 1868);
        assertEq(end, 1873);
        vm.warp(1793614932);
        _ledger();
        nft.settleTraining(id);
        assertEq(nft.hamster(id).stamina, 4058); // 10 + 1012 * 2 * 20000 / 10000
    }
}
